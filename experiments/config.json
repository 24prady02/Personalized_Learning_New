{
  "experiment": "think_on_the_graph",
  "kg": "data/raw/chapter1_kg.json",
  "scenarios": "data/raw/scenarios_20.json",
  "hops": 0,
  "keep_generic": false,
  "inputs_read": ["scenario code (stage 1)", "question and student answer (stage 2 only)"],
  "inputs_not_read": ["concept aliases", "gold labels (checking only)"],
  "traversal": {
    "width": 3,
    "depth": 3,
    "temperature": 0,
    "max_output": 256,
    "prune_tools": "llm",
    "backend": "claude-cli",
    "model": "claude-opus-5-5",
    "few_shot_scenario": "S000",
    "cache_dir": "experiments/llm_cache",
    "start": "stage1",
    "stop": "rule"
  },
  "outputs": {
    "processed": "data/processed/<sid>_subgraph.json",
    "diagnosis": "data/processed/<sid>_diagnosis.json",
    "traversal_log": "experiments/logs/traverse_<sid>.txt",
    "report": "experiments/logs/subgraph_report.txt",
    "pattern_bank": "experiments/pattern_bank.json",
    "figures": "results/figures/<sid>.png",
    "summary": "results/tables/summary.csv",
    "listing": "results/results.md",
    "metrics": "results/metrics.json"
  }
}
